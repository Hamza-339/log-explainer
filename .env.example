# Must be Neon's pooled connection string (host contains "-pooler"), per ADR-0001.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Used by the explainer to generate structured error explanations.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: defaults to claude-haiku-4-5-20251001 if unset.
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Outgoing webhook (e.g. a Slack/Discord incoming webhook URL) that receives a
# plain-language notification when a novel error is explained. Optional: if
# unset, notification is skipped.
NOTIFICATION_WEBHOOK_URL="https://hooks.slack.com/services/..."
